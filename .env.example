# 이 파일을 `.env` 로 복사한 뒤 본인 값을 채우세요.
#   cp .env.example .env
# `.env` 는 .gitignore 에 등록돼 있어 커밋되지 않습니다. 값을 채운 뒤에도
# 절대 커밋하거나 채팅·이슈에 붙여넣지 마세요.

# ── 텔레그램 (필수) ────────────────────────────────────────────────
# https://my.telegram.org → API development tools 에서 발급.
# 본인 계정으로 구독 중인 브로드캐스트 채널을 읽기 전용으로 수집합니다.
# 발급 후 `python scripts/telegram_login_setup.py` 를 직접 터미널에서 1회 실행.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── 토스증권 Open API (선택) ───────────────────────────────────────
# 코스피·코스닥·국고채 금리를 KRX 원천으로 받습니다.
# 없어도 동작하며, 이 경우 야후로 폴백하고 국고채 10Y 지표만 빠집니다.
# 다만 야후는 장중 조회 시 그 시점 값을 종가처럼 돌려주므로 당일 지수가
# 틀릴 수 있습니다(실측 92포인트 차이).
#
# 발급: 토스증권 앱/웹 → 설정 → Open API → Key 발급
#  · Client Secret 은 발급 시 한 번만 표시됩니다. 놓치면 재발급하세요.
#  · '허용 IP 관리' 에 현재 공인 IP 를 등록해야 합니다(미등록 시 403).
#    현재 IP 확인: curl https://api.ipify.org
#    회선 IP 가 바뀌면 다시 등록해야 합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
